---
import Base from "./Base.astro";

interface Props {
  titulo: string;
  actualizado?: string;
  resumen?: string;
}
// Fecha unica para todas las paginas legales: si cada una lleva la suya, se
// desincronizan y no hay forma de saber cual es la version vigente.
const { titulo, actualizado = "4 de septiembre de 2026", resumen } = Astro.props;
---

<Base titulo={titulo}>
  <article class="max-w-3xl mx-auto px-4 py-10 sm:py-14">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{titulo}</h1>
    <p class="mt-2 text-sm text-neutral-500">Ultima actualizacion: {actualizado}</p>
    {
      resumen && (
        <p class="mt-4 text-neutral-700 bg-marca-50 border border-marca-100 rounded-xl p-4 leading-relaxed">
          {resumen}
        </p>
      )
    }
    <div
      class="prose-farmaweb mt-8 space-y-5 text-neutral-800 leading-relaxed
             [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:mt-8 [&_h2]:mb-2
             [&_h3]:font-semibold [&_h3]:mt-5
             [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5
             [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-1.5
             [&_a]:text-marca-700 [&_a]:underline [&_a]:underline-offset-2
             [&_strong]:font-semibold"
    >
      <slot />
    </div>
  </article>
</Base>
